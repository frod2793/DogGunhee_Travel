        <StatValues>
            <WeaponStat name="Damage">40</WeaponStat>
            <WeaponStat name="Cooldown">3.5</WeaponStat>
        </StatValues>
        <Evolution>
            <Name>캡틴 방쿤맨</Name>
            <FlavorText>항상 배개로 삼던 히어로 만화책의 영감을 받아 새로 고안해 낸 기술입니다.</FlavorText>
        </Evolution>
        <Upgrades>
            <Level num="2" stat="Damage" value="1.1" mode="multiply" />
            <Level num="3" stat="Damage" value="1.1" mode="multiply" />
            <Level num="4" stat="Cooldown" value="0.9" mode="multiply" />
            <Level num="5" stat="WeaponSize" value="1.1" mode="multiply" />
            <Level num="6" stat="WeaponSize" value="1.1" mode="multiply" />
            <Level num="6" stat="Damage" value="1.1" mode="multiply" />
        </Upgrades>
