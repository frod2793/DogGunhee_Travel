  allSkills:
  - skillCode: 1
    skillName: "\uBAA9\uC904"
    skillDescription: "\uBAA9\uC904\uC5D4 \uC560\uC815\uC744 \uB2F4\uC544 \uC801\uC740
      \uC774\uB984\uC774 \uC801\uD600\uC788\uC2B5\uB2C8\uB2E4. \uAD6C\uB458\uC6B4
      \uC544\uB9C8 \uAC70\uC871\uACFC \uB2E4\uB984\uC5C6\uC2B5\uB2C8\uB2E4."
    skillIcon: {fileID: 21300000, guid: bd9ceb3996b279b418e0e8ff04234d1a, type: 3}
  - skillCode: 2
    skillName: "\uD504\uB85C\uD2F4"
    skillDescription: "\uCD08\uD2B9\uAC00 \uB3D9\uBBAC\uC6A9 \uD504\uB85C\uD2F4!
      \uBA39\uC73C\uBA74 \uC5C4\uCCAD\uB09C \uD798\uC744 \uAC00\uC9C8\uC218\uC788\uC2B5\uB2C8\uB2E4."
    skillIcon: {fileID: 21300000, guid: ec0f03c1decc0444aa03cb2ed79eef07, type: 3}
  - skillCode: 3
    skillName: "\uC2E0\uBE44\uC758 \uAE43\uD138"
    skillDescription: "\uC544\uC2DC\uB098\uC694? \uAE43\uD138\uC758 \uBC29\uD5A5\uB9CC
      \uC798 \uB9DE\uCD98\uB2E4\uBA74 \uACF5\uAE30\uC5ED\uD559 \uC801....\uC74D\uC74D
      !!"
    skillIcon: {fileID: 21300000, guid: 5f1abd29a5908a24eb32cf867a91aa44, type: 3}
  - skillCode: 4
    skillName: "\uC2E0\uBE44\uD55C \uC5F4\uB9E4"
    skillDescription: "\uBC14\uB2E4 \uAE4A\uC740 \uACF3\uC5D0 \uC790\uB77C\uC788\uB358
      \uC5F4\uB9E4\uC785\uB2C8\uB2E4. \uD55C \uC785\uB9CC \uBA39\uC5B4\uB3C4 \uBAB8\uC5D0
      \uC2E0\uBE44\uD55C \uD798\uC774 \uAE43\uB4E0\uB2E4\uACE0 \uC804\uD574\uC9D1\uB2C8\uB2E4."
    skillIcon: {fileID: 21300000, guid: 8500f68d238d28b469698c3154830f8b, type: 3}
  - skillCode: 5
    skillName: "\uB9C8\uBC95 \uC8FC\uC0AC\uAE30"
    skillDescription: "\uC608\uBC29\uC811\uC885\uC740 \uD544\uC218\uC785\uB2C8\uB2E4.
      \uB3D9\uBB3C \uCE5C\uAD6C\uB4E4\uC740 \uC8FC\uC0AC\uB97C \uBB34\uC11C\uC6CC
      \uD558\uC9C0\uB9CC \uC544\uD504\uC9C0 \uC54A\uC73C\uB824\uBA74 \uC5B4\uCA54\uC218
      \uC5C6\uC9C0\uC694."
    skillIcon: {fileID: 21300000, guid: b04a5c6bc25114fcd8e8314ae6e52ace, type: 3}
  - skillCode: 6
    skillName: "\uADF8\uBB3C"
    skillDescription: "\uC774 \uADF8\uBB3C\uC5D0 \uC7A1\uD78C\uAC74 \uBB34\uC5C7\uB3C4
      \uBE60\uC838\uB098\uAC08\uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uC774\uB7F0! \uC628\uD1B5
      \uC4F0\uB808\uAE30\uB9CC \uC7A1\uD788\uB124\uC694."
    skillIcon: {fileID: 21300000, guid: d4681c6ed4a22eb4f8f5bebb5dc3a4f7, type: 3}
  - skillCode: 7
    skillName: "\uACE0\uC591\uC774 \uB09A\uC2EF\uB300"
    skillDescription: "\uACE0\uC591\uC774\uAC00 \uC88B\uC544\uD558\uB294 \uBC29\uC6B8\uACFC
      \uAE43\uD138\uC774 \uB2EC\uB824 \uC788\uC2B5\uB2C8\uB2E4! \uBC8C\uC368 \uC8FC\uBCC0\uC5D0\uC11C
      \uD638\uAE30\uC2EC\uC758 \uB208\uBE5B\uC774 \uB290\uAEF4\uC9C0\uB124\uC694."
    skillIcon: {fileID: 21300000, guid: 104c13d23f0d8814a828c290cd7664f8, type: 3}
  - skillCode: 8
    skillName: "\uB0A1\uC740 \uBC29\uD328"
    skillDescription: "\uB0A1\uC740 \uBC29\uD328\uC785\uB2C8\uB2E4. \uD558\uC9C0\uB9CC
      \uB204\uAD70\uAC00\uAC00 \uC5F4\uC2EC\uD788 \uAD00\uB9AC\uD55C\uB4EF, \uBC18\uC9DD\uBC18\uC9DD
      \uAD11\uC774 \uB098\uB294 \uAD70\uC694."
    skillIcon: {fileID: 21300000, guid: bdecb23fa8d5fc744b7c1d5f9154028a, type: 3}
